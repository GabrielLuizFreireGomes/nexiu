---
/**
 * Botões com dois estilos de hover:
 *  - "fill": círculo que preenche a partir do ponto de entrada do mouse + seta que troca
 *  - "roll": letras rolam para cima em cascata
 */
interface Props {
  href: string;
  label: string;
  variant?: 'fill' | 'roll';
  tone?: 'dark' | 'red' | 'light' | 'outline';
  external?: boolean;
  icon?: 'arrow' | 'whatsapp';
  class?: string;
}
const { href, label, variant = 'fill', tone = 'dark', external = false, icon = 'arrow', class: cls = '' } = Astro.props;
const letters = [...label];
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${tone}`, cls]}
  data-magnetic="0.25"
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <span class="btn__label" aria-label={label}>
    {letters.map((l, i) => (
      <span class="btn__char" style={`--i:${i}`} aria-hidden="true">{l === ' ' ? ' ' : l}</span>
    ))}
  </span>
  <span class="btn__icon" aria-hidden="true">
    {icon === 'whatsapp' ? (
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.41 1.3-1.95 1.35-.5.05-.97.23-3.28-.68-2.78-1.1-4.54-3.95-4.68-4.13-.13-.18-1.12-1.49-1.12-2.84s.71-2.02.96-2.29c.25-.27.55-.34.73-.34l.52.01c.17 0 .39-.06.61.47.24.56.79 1.93.86 2.07.07.14.11.3.02.48-.09.18-.14.3-.27.46l-.41.48c-.14.14-.28.29-.12.56.16.27.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.27.14.43.11.59-.07.16-.18.68-.8.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.33Z"/></svg>
    ) : (
      <span class="btn__arrows">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    )}
  </span>
</a>
