---
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/global.css'
import { profile } from '../data/profile.js'

// Servida pelo nginx (error_page 404) em qualquer endereço que não existe.
// Fica fora do Google (noindex) e leva de volta para a página inicial.
const title = `Página não encontrada | ${profile.name}`
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07080f" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <title>{title}</title>
  </head>
  <body>
    <main class="not-found">
      <p class="code">404</p>
      <h1>Essa página se perdeu no espaço.</h1>
      <p>O endereço que você abriu não existe ou mudou de lugar.</p>
      <a class="home" href="/">Voltar para o início</a>
    </main>
    <style>
      .not-found {
        min-height: 100vh;
        display: grid;
        place-content: center;
        gap: 1rem;
        padding: 2rem 1rem;
        text-align: center;
      }
      .code {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(4rem, 18vw, 8rem);
        font-weight: 700;
        line-height: 1;
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      h1 {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(1.5rem, 5vw, 2.25rem);
      }
      p {
        margin: 0;
        color: var(--text-muted);
      }
      .home {
        justify-self: center;
        margin-top: 1rem;
        padding: 0.8rem 1.4rem;
        border-radius: 999px;
        background: var(--gradient-accent-strong);
        color: var(--text-on-accent);
        font-weight: 600;
        text-decoration: none;
      }
      .home:focus-visible {
        outline: 2px solid var(--blue-light);
        outline-offset: 3px;
      }
    </style>
  </body>
</html>
